<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Packing & Tooling Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gitic</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Version>0.2.1</Version>
    <Description>Gitic Strategic Codebase Analysis CLI</Description>
    <Authors>Author</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.6.26359.118" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kfc.Cli.Core" Version="0.1.12" />
    <PackageReference Include="Kfc.Cli.Terminal" Version="0.1.12" />
    <PackageReference Include="Kfc.Cli.Tui" Version="0.1.12" />
  </ItemGroup>

</Project>